{
  "name": "gaia-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=!console build && pnpm --filter console build",
    "dev": "concurrently -n api,console -c cyan,magenta \"pnpm --filter @gaia/api dev\" \"pnpm --filter @gaia/console dev\"",
    "typecheck": "pnpm run build:libs && pnpm -r typecheck",
    "test": "pnpm run build:libs && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:libs": "pnpm --filter @gaia/core --filter @gaia/service build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@duckdb/node-bindings-darwin-arm64",
      "@duckdb/node-bindings",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "json-schema-to-zod": "^2.6.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
