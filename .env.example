# Copy to console/.env.local and fill in. Nothing here is required by the map or the
# report — they read the layer directly. Only the agent playground needs a model key.

# Groq serves an OpenAI-compatible API on a free tier, which is what the playground uses.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Where the console reaches the layer's REST API.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8811

# Optional: when set, the REST API requires this in the x-gaia-key header.
GAIA_API_KEY=
