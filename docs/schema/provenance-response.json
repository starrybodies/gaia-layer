{
  "$defs": {
    "ConfidenceBasis": {
      "additionalProperties": false,
      "description": "How the confidence score was arrived at.\n\nv0.1 keeps this deliberately simple, as the build prompt directs: composite pixel\ncount, cloud fraction, and sensor revisit gap. The structure admits more components\nlater without changing the envelope shape.",
      "properties": {
        "aggregation": {
          "default": "weighted_arithmetic_mean",
          "description": "How components combine into the score.",
          "title": "Aggregation",
          "type": "string"
        },
        "cloud_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean cloud fraction across contributing scenes.",
          "title": "Cloud Fraction"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ConfidenceComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "observation_count": {
          "description": "Number of source observations composited into this value.",
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "revisit_gap_days": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longest gap between contributing observations.",
          "title": "Revisit Gap Days"
        },
        "spatial_coverage": {
          "description": "Fraction of the geometry with a valid observation.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Spatial Coverage",
          "type": "number"
        }
      },
      "required": [
        "observation_count",
        "spatial_coverage",
        "components"
      ],
      "title": "ConfidenceBasis",
      "type": "object"
    },
    "ConfidenceComponent": {
      "additionalProperties": false,
      "description": "One named input to the confidence score, kept separate so the score decomposes.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "description": "Component score, 1.0 being ideal.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "weight",
        "description"
      ],
      "title": "ConfidenceComponent",
      "type": "object"
    },
    "IndicatorId": {
      "description": "Every quantity the layer can serve.\n\nGrouped by family; the family is derivable via :func:`indicator_family`.",
      "enum": [
        "ndvi",
        "ndmi",
        "nbr",
        "vpd_kpa",
        "precip_30d_mm",
        "temp_max_c",
        "days_since_rain",
        "soil_moisture_0_7cm",
        "soil_moisture_7_28cm",
        "elevation_m",
        "slope_deg",
        "aspect_deg",
        "twi"
      ],
      "title": "IndicatorId",
      "type": "string"
    },
    "JsonValue": {},
    "Method": {
      "additionalProperties": false,
      "description": "The published method a value was computed by, so a consumer can check the maths.",
      "properties": {
        "citation": {
          "description": "Full bibliographic citation for the method.",
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name",
        "citation"
      ],
      "title": "Method",
      "type": "object"
    },
    "ProvenanceStep": {
      "additionalProperties": false,
      "description": "One link in the chain.\n\nThe six fields the build prompt calls non-negotiable for an ingested record \u2014 source,\ndataset id, acquisition time, processing time, pipeline version, spatial reference \u2014\nare all here. They are optional only where the step kind makes them meaningless: a\nvalidation step has no acquisition timestamp of its own, it inherits the one carried by\nthe observation steps beneath it.",
      "properties": {
        "access_route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the data was reached, e.g. 'earth-search-v1' or 'open-meteo-archive'. Distinguishes the dataset from the intermediary that served it.",
          "title": "Access Route"
        },
        "acquired_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the underlying observation was made.",
          "title": "Acquired At"
        },
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "asset_ids": {
          "description": "Scene, granule or asset identifiers consumed by this step.",
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dataset identifier, e.g. 'sentinel-2-l2a'.",
          "title": "Dataset Id"
        },
        "description": {
          "description": "Plain-language account of what this step did.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "index": {
          "description": "Position in the chain, 0 first.",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/StepKind"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Every parameter that affects the numeric output of this step.",
          "title": "Parameters",
          "type": "object"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "processed_at": {
          "description": "When this step ran.",
          "format": "date-time",
          "title": "Processed At",
          "type": "string"
        },
        "resolution_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution M"
        },
        "software": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Library and version doing the work, e.g. 'rasterio 1.4.3'.",
          "title": "Software"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Originating organisation, e.g. 'ESA/Copernicus'.",
          "title": "Source"
        },
        "spatial_ref": {
          "description": "CRS of this step's output, as an authority code, e.g. 'EPSG:32610'.",
          "title": "Spatial Ref",
          "type": "string"
        }
      },
      "required": [
        "index",
        "kind",
        "description",
        "processed_at",
        "pipeline_version",
        "algorithm_version",
        "spatial_ref"
      ],
      "title": "ProvenanceStep",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "warn",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "A distinct source observation underlying a claim.",
      "properties": {
        "access_route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Route"
        },
        "acquired_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquired At"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "spatial_ref": {
          "title": "Spatial Ref",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source",
        "dataset_id",
        "asset_id",
        "spatial_ref"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "StepKind": {
      "description": "What a provenance step represents.\n\nA well-formed chain starts with at least one ``observation`` and ends with a\n``validation``. Everything between is ``processing``.",
      "enum": [
        "observation",
        "processing",
        "validation"
      ],
      "title": "StepKind",
      "type": "string"
    },
    "ValidationFlag": {
      "additionalProperties": false,
      "description": "A constraint the value did not satisfy.\n\nFlags travel with the value rather than replacing it. A consumer that ignores flags\ngets a number; a consumer that reads them gets a number and the reason to discount it.",
      "properties": {
        "code": {
          "description": "Stable machine-readable flag code.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "confidence_penalty": {
          "default": 0.0,
          "description": "Multiplicative reduction this flag applied to the confidence score.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Penalty",
          "type": "number"
        },
        "constraint": {
          "description": "Identifier of the constraint that produced this flag.",
          "minLength": 1,
          "title": "Constraint",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the constraint required, in plain language.",
          "title": "Expected"
        },
        "message": {
          "description": "Plain-language explanation.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value that tripped the check.",
          "title": "Observed"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "constraint",
        "severity",
        "message"
      ],
      "title": "ValidationFlag",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "description": "The constraint engine's verdict on one candidate value, before it becomes a claim.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_basis": {
          "$ref": "#/$defs/ConfidenceBasis"
        },
        "constraints_checked": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Constraints Checked",
          "type": "array"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/ValidationFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "status": {
          "enum": [
            "validated",
            "flagged",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "constraints_checked",
        "confidence",
        "confidence_basis"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Full trace of a previously served claim back to source observations.",
  "properties": {
    "claim_id": {
      "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Claim Id",
      "type": "string"
    },
    "claim_kind": {
      "enum": [
        "numeric",
        "trend",
        "substrate_score"
      ],
      "title": "Claim Kind",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "indicator": {
      "anyOf": [
        {
          "$ref": "#/$defs/IndicatorId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "method": {
      "$ref": "#/$defs/Method"
    },
    "provenance": {
      "description": "Ordered chain from source observation to validated output. Never empty \u2014 a value without provenance cannot be constructed.",
      "items": {
        "$ref": "#/$defs/ProvenanceStep"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "served_at": {
      "description": "When this claim was first emitted.",
      "format": "date-time",
      "title": "Served At",
      "type": "string"
    },
    "sources": {
      "description": "Deduplicated source observations behind the claim.",
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    },
    "value_repr": {
      "description": "The value as originally served, rendered as text.",
      "title": "Value Repr",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "claim_kind",
    "value_repr",
    "unit",
    "confidence",
    "validation",
    "method",
    "provenance",
    "sources",
    "served_at",
    "generated_at"
  ],
  "title": "ProvenanceResponse",
  "type": "object"
}
