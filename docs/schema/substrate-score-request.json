{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Axis-aligned bounding box in WGS84 degrees.",
      "properties": {
        "east": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "BBox",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "GeoJSON Polygon, WGS84 lon/lat, per RFC 7946.",
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "Date to score. Resolves to the month containing it.",
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/Polygon"
        },
        {
          "$ref": "#/$defs/MultiPolygon"
        },
        {
          "$ref": "#/$defs/BBox"
        }
      ],
      "title": "Geometry"
    }
  },
  "required": [
    "geometry",
    "date"
  ],
  "title": "SubstrateScoreRequest",
  "type": "object"
}
