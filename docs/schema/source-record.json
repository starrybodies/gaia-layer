{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A distinct source observation underlying a claim.",
  "properties": {
    "access_route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Route"
    },
    "acquired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquired At"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "spatial_ref": {
      "title": "Spatial Ref",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "source",
    "dataset_id",
    "asset_id",
    "spatial_ref"
  ],
  "title": "SourceRecord",
  "type": "object"
}
