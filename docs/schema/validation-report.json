{
  "$defs": {
    "ConfidenceBasis": {
      "additionalProperties": false,
      "description": "How the confidence score was arrived at.\n\nv0.1 keeps this deliberately simple, as the build prompt directs: composite pixel\ncount, cloud fraction, and sensor revisit gap. The structure admits more components\nlater without changing the envelope shape.",
      "properties": {
        "aggregation": {
          "default": "weighted_arithmetic_mean",
          "description": "How components combine into the score.",
          "title": "Aggregation",
          "type": "string"
        },
        "cloud_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean cloud fraction across contributing scenes.",
          "title": "Cloud Fraction"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ConfidenceComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "observation_count": {
          "description": "Number of source observations composited into this value.",
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "revisit_gap_days": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longest gap between contributing observations.",
          "title": "Revisit Gap Days"
        },
        "spatial_coverage": {
          "description": "Fraction of the geometry with a valid observation.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Spatial Coverage",
          "type": "number"
        }
      },
      "required": [
        "observation_count",
        "spatial_coverage",
        "components"
      ],
      "title": "ConfidenceBasis",
      "type": "object"
    },
    "ConfidenceComponent": {
      "additionalProperties": false,
      "description": "One named input to the confidence score, kept separate so the score decomposes.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "description": "Component score, 1.0 being ideal.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "weight",
        "description"
      ],
      "title": "ConfidenceComponent",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "warn",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationFlag": {
      "additionalProperties": false,
      "description": "A constraint the value did not satisfy.\n\nFlags travel with the value rather than replacing it. A consumer that ignores flags\ngets a number; a consumer that reads them gets a number and the reason to discount it.",
      "properties": {
        "code": {
          "description": "Stable machine-readable flag code.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "confidence_penalty": {
          "default": 0.0,
          "description": "Multiplicative reduction this flag applied to the confidence score.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Penalty",
          "type": "number"
        },
        "constraint": {
          "description": "Identifier of the constraint that produced this flag.",
          "minLength": 1,
          "title": "Constraint",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the constraint required, in plain language.",
          "title": "Expected"
        },
        "message": {
          "description": "Plain-language explanation.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value that tripped the check.",
          "title": "Observed"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "constraint",
        "severity",
        "message"
      ],
      "title": "ValidationFlag",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The constraint engine's verdict on one candidate value, before it becomes a claim.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "confidence_basis": {
      "$ref": "#/$defs/ConfidenceBasis"
    },
    "constraints_checked": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Constraints Checked",
      "type": "array"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/ValidationFlag"
      },
      "title": "Flags",
      "type": "array"
    },
    "status": {
      "enum": [
        "validated",
        "flagged",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "constraints_checked",
    "confidence",
    "confidence_basis"
  ],
  "title": "ValidationReport",
  "type": "object"
}
